{
  "name": "jobfiend",
  "compatibility_date": "2024-09-06",
  "workers_dev": true,
  "main": "./worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jobfiend-signups",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "routes": [
    { "pattern": "jobfiend.io", "custom_domain": true }
  ]
}
