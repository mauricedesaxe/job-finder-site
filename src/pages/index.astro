---
import PageLayout from '../layouts/PageLayout.astro';

const title = 'Job Fiend';
const description =
  "I'll run an automated private job search customized just for you and the only thing it will cost you is some honest feedback on the process.";

const steps = [
  {
    title: 'How it works',
    paragraphs: [
      "My system will search for jobs for you every day based on criteria you provided and then put them in a review queue.",
      "As you pursue or reject provided jobs, the system learns what you want and gives you more of that.",
    ],
  },
  {
    title: 'Free and open',
    paragraphs: [
      "Everything is open source and the system itself, not including its various underlying vendors and providers, is free to use.",
      "This means that you can set it up yourself but to abstract that work from you, I offer a limited number of free managed plans.",
    ],
  },
  {
    title: "I'll hold your hand through the process",
    paragraphs: [
      "We book a call and I spend time with you learning about you. I want to know about your experiences. I want to know about your needs, wants, and desires.",
      "We point the system at your profile while on the call and we look at the first few jobs it finds together.",
    ],
  },
  {
    title: "You'll receive jobs daily",
    paragraphs: [
      "Once we're done with our call, the system should have some degree of understanding about what jobs you want and it should give you more jobs every day.",
      "I want you to review them. I want you to give feedback when a job is bad and when a job is good and why.",
    ],
  },
  {
    title: "What's the price?",
    paragraphs: [
      "This is the core value exchange I'm asking for from you.",
      "My system will absolutely find you jobs once it's past that initial learning phase. I know because it found me jobs that I liked and applied to.",
      "But I need to be able to collect this feedback from you to be able to improve the system even further so that more people can benefit from it.",
    ],
  },
  {
    title: "Why it's free",
    paragraphs: [
      "As everything stands right now I'm not making any money from this. I'm not charging you. I'm not charging the employer.",
      "In fact I'm spending out of pocket on all the vendors and providers underneath the system that will run for you.",
      "I do this, of course, not out of the kindness of my soul. I am hoping that as I show this to more people and I gather more feedback, I will eventually be able to turn it into some sort of a commercial project.",
    ],
  },
];

const circlePath =
  'M20 3.2 C 30.5 2.2, 37.6 8.8, 37.2 19.6 C 36.8 30.6, 30.2 36.9, 19.8 36.8 C 9.4 36.7, 2.9 30.4, 3.1 19.8 C 3.3 9.6, 9.8 4.2, 20 3.2';

// One distinct hand-drawn connector per step gap, all ending bottom-left in an
// open arrowhead (cards mirror them via CSS).
const connectors = [
  {
    // loop-de-loop — the feedback loop
    body: 'M100 8 C 76 2, 58 6, 50 16 C 43 25, 48 36, 56 33 C 64 30, 64 20, 56 18 C 48 16, 38 27, 24 42',
    head: 'M28 36 L 16 47 L 31 51',
  },
  {
    // wobble wave — nervous energy
    body: 'M100 8 Q 92 22, 84 14 Q 76 6, 70 18 Q 64 30, 56 22 Q 48 14, 44 28 Q 40 42, 30 38 Q 24 36, 22 46',
    head: 'M28 36 L 16 47 L 31 51',
  },
  {
    // zigzag — lightning
    body: 'M100 8 L 80 18 L 92 30 L 68 38 L 78 50 L 52 50',
    head: 'M44 42 L 30 51 L 46 56',
  },
  {
    // serpentine — long lazy S
    body: 'M100 6 C 64 -2, 84 28, 52 32 C 26 35, 36 46, 22 46',
    head: 'M28 36 L 16 47 L 31 51',
  },
  {
    // dashed cut — the price line
    body: 'M100 10 C 70 2, 40 14, 22 42',
    head: 'M28 36 L 16 47 L 31 51',
    dash: '7 6',
  },
];
---

<PageLayout title={title} description={description} canonicalPath="/">
  <main class="page">
    <header class="hero">
      <div class="hero-grid">
        <div class="hero-copy">
          <h1>{title}</h1>
          <svg class="scribble" viewBox="0 0 220 18" aria-hidden="true">
            <path
              d="M2 11 C 28 4, 46 16, 72 9 S 120 17, 148 8 S 196 15, 218 10"
              fill="none"
              stroke="#49B6E5"
              stroke-width="3"
              stroke-linecap="round"
            />
          </svg>
          <p class="lede">{description}</p>
          <div class="actions">
            <svg class="arrow" viewBox="0 0 110 64" aria-hidden="true">
              <path
                d="M100 8 C 68 2, 34 14, 18 44"
                fill="none"
                stroke="#49B6E5"
                stroke-width="3"
                stroke-linecap="round"
              />
              <path
                d="M28 36 L 16 47 L 31 51"
                fill="none"
                stroke="#49B6E5"
                stroke-width="3"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
            <a class="book" href="#intake">Book a setup</a>
            <a
              class="repo"
              href="https://github.com/mauricedesaxe/job-finder"
              rel="noopener noreferrer">Github Repo</a
            >
          </div>
        </div>
        <div class="hero-media">
          <div class="demo-frame video-facade">
            <div class="video-window">
              <button
                class="facade-play"
                type="button"
                data-video="https://www.youtube-nocookie.com/embed/bO7vzA0xbWg?autoplay=1"
                aria-label="Play the demo video"
              >
                <span class="play-badge">
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M8 5.5 L 18 12 L 8 18.5 Z" />
                  </svg>
                </span>
              </button>
            </div>
          </div>
          <p class="video-caption">Me, running it live on my own job search.</p>
        </div>
      </div>
    </header>

    <div class="steps">
      {steps.map((step, i) => (
        <section class="block card">
          {i > 0 && (
            <svg class="connector" viewBox="0 0 110 64" aria-hidden="true">
              <path
                d={connectors[i - 1].body}
                fill="none"
                stroke="#49B6E5"
                stroke-width="3"
                stroke-linecap="round"
                stroke-dasharray={connectors[i - 1].dash}
              />
              <path
                d={connectors[i - 1].head}
                fill="none"
                stroke="#49B6E5"
                stroke-width="3"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          )}
          <span class="marker" aria-hidden="true">
            <svg viewBox="0 0 40 40">
              <path
                d={circlePath}
                fill="none"
                stroke="#263D5B"
                stroke-width="2"
                stroke-linecap="round"
                filter="url(#wobble)"
              />
            </svg>
            <span class="marker-n">{i + 1}</span>
          </span>
          <div class="block-body">
            <h2>{step.title}</h2>
            {step.paragraphs.map((paragraph) => (
              <p class="sub">{paragraph}</p>
            ))}
            {i === 0 && (
              <img
                class="card-img"
                src="/images/job-fiend-desk.webp"
                alt=""
                width="1130"
                height="1046"
                loading="lazy"
              />
            )}
            {i === 4 && (
              <img
                class="card-img"
                src="/images/job-fiend-sign.webp"
                alt="A cardboard sign reading: will find you jobs for free"
                width="741"
                height="1154"
                loading="lazy"
              />
            )}
          </div>
        </section>
      ))}
    </div>

    <section class="intake" id="intake">
      <svg class="scribble" viewBox="0 0 220 18" aria-hidden="true">
        <path
          d="M2 11 C 28 4, 46 16, 72 9 S 120 17, 148 8 S 196 15, 218 10"
          fill="none"
          stroke="#49B6E5"
          stroke-width="3"
          stroke-linecap="round"
        />
      </svg>
      <h2>Book your setup call</h2>
      <img
        class="call-img"
        src="/images/job-fiend-call.webp"
        alt="The Job Fiend character at his desk, answering a phone call."
        width="1092"
        height="1056"
        loading="lazy"
      />
      <p class="intake-lede">
        I don't want to waste your time nor mine. For the white glove offering
        to work well for you and be worth it to me, it would be best if you had
        at least a couple of years of experience and if you are based in Europe
        or North America. If that's not you, either use the open-source version
        of the system or sign up for the waitlist.
      </p>
      <form class="intake-form" id="intake-form">
        <fieldset>
          <legend>1 · Where are you in your career?</legend>
          <label><input type="radio" name="level" value="junior" /> Junior</label>
          <label><input type="radio" name="level" value="mid" checked /> Mid-level</label>
          <label>
            <input type="radio" name="level" value="senior" /> Senior or above
          </label>
        </fieldset>

        <fieldset>
          <legend>2 · Where are you based?</legend>
          <label><input type="radio" name="region" value="eu" checked /> Europe</label>
          <label>
            <input type="radio" name="region" value="na" /> North America
          </label>
          <label>
            <input type="radio" name="region" value="other" /> Somewhere else
          </label>
        </fieldset>

        <label class="wide">
          <span class="q">3 · What are you looking for?</span>
          <textarea
            name="looking"
            rows="5"
            placeholder="The types of role, stack, compensation, time zone, or other constraints that you're looking for would be useful to know."></textarea>
        </label>

        <div class="hp" aria-hidden="true">
          <label>Leave this field empty <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
        </div>
      </form>
      <div class="verdict" id="verdict" aria-live="polite"></div>

      <template id="fit">
        <h3>You're who this is for.</h3>
        <p>
          Book a time. We point the system at your profile on the call and look
          at the first jobs it finds together.
        </p>
        <a class="book book-big" href="https://cal.com/alexlazar/30-min-meeting"
          >Book a setup</a
        >
      </template>

      <template id="waitlist-junior">
        <h3>Not yet.</h3>
        <p>
          I'm not offering the white-glove experience to junior developers just
          yet. Feel free to use the open-source version of the system yourself
          and put your email in to get updates.
        </p>
        <div class="waitlist-row">
          <input type="email" placeholder="you@example.com" aria-label="Email" />
          <button class="book" type="button">Join the waitlist</button>
        </div>
        <p class="waitlist-note">Product updates if I get traction and decide to take this project further.</p>
      </template>

      <template id="waitlist-region">
        <h3>Not here yet.</h3>
        <p>
          I'm not offering the white-glove experience to people outside of
          Europe or North America just yet. Feel free to use the open-source
          version of the system yourself and put your email in to get updates.
        </p>
        <div class="waitlist-row">
          <input type="email" placeholder="you@example.com" aria-label="Email" />
          <button class="book" type="button">Join the waitlist</button>
        </div>
        <p class="waitlist-note">Product updates if I get traction and decide to take this project further.</p>
      </template>
    </section>
  </main>
</PageLayout>

<script>
  document.querySelectorAll<HTMLButtonElement>('.facade-play').forEach((button) => {
    button.addEventListener('click', () => {
      const frame = button.parentElement;
      if (!frame) return;
      const iframe = document.createElement('iframe');
      iframe.src = button.dataset.video ?? '';
      iframe.title = 'Job Fiend demo';
      iframe.allow =
        'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
      iframe.allowFullscreen = true;
      frame.classList.add('playing');
      frame.replaceChildren(iframe);
    });
  });
</script>

<script>
  const form = document.getElementById('intake-form') as HTMLFormElement;
  const verdict = document.getElementById('verdict') as HTMLElement;

  const LEVEL_LABEL: Record<string, string> = {
    junior: 'Junior',
    mid: 'Mid-level',
    senior: 'Senior or above',
  };
  const REGION_LABEL: Record<string, string> = {
    eu: 'Europe',
    na: 'North America',
    other: 'Somewhere else',
  };
  const EMAIL_RE = /^\S+@\S+\.\S+$/;

  function readIntake() {
    const data = new FormData(form);
    return {
      level: (data.get('level') as string) ?? 'mid',
      region: (data.get('region') as string) ?? 'eu',
      looking: ((data.get('looking') as string) ?? '').trim(),
      website: (data.get('website') as string) ?? '',
    };
  }

  function postIntake(payload: Record<string, string>) {
    return fetch('/api/intake', {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify(payload),
      keepalive: true,
    });
  }

  function showWaitlistError(row: Element, message: string) {
    let error = row.nextElementSibling;
    if (!error || !error.classList.contains('waitlist-error')) {
      error = document.createElement('p');
      error.className = 'waitlist-error';
      error.setAttribute('role', 'alert');
      row.after(error);
    }
    error.textContent = message;
  }

  // The verdict only depends on the two radios. Re-rendering it on text-field
  // changes detaches the action mid-click (mousedown blurs the field, the
  // change re-render eats the click), so route on radios only.
  let currentId: string | null = null;
  let savedEmail = '';

  function route() {
    const data = new FormData(form);
    const level = (data.get('level') as string) ?? 'mid';
    const region = (data.get('region') as string) ?? 'eu';
    const id =
      level === 'junior' ? 'waitlist-junior' : region === 'other' ? 'waitlist-region' : 'fit';
    if (id === currentId) return;
    currentId = id;
    const tpl = document.getElementById(id) as HTMLTemplateElement;
    const frag = tpl.content.cloneNode(true) as DocumentFragment;
    if (savedEmail) {
      frag.querySelectorAll<HTMLInputElement>('input[type="email"]').forEach((input) => {
        input.value = savedEmail;
      });
    }
    verdict.replaceChildren(frag);
  }

  form.addEventListener('change', (event) => {
    if ((event.target as HTMLInputElement).type === 'radio') route();
  });
  verdict.addEventListener('input', (event) => {
    if ((event.target as HTMLElement).matches('input[type="email"]')) {
      savedEmail = (event.target as HTMLInputElement).value;
    }
  });
  route();

  verdict.addEventListener('click', async (event) => {
    const target = event.target as HTMLElement;

    const bookLink = target.closest<HTMLAnchorElement>('a.book-big');
    if (bookLink) {
      event.preventDefault();
      const { level, region, looking, website } = readIntake();
      const notes = [
        'From the Job Fiend intake form:',
        `Career level: ${LEVEL_LABEL[level] ?? level}`,
        `Based in: ${REGION_LABEL[region] ?? region}`,
        looking ? `Looking for: ${looking.slice(0, 500)}` : null,
      ]
        .filter(Boolean)
        .join('\n');
      const url = `${bookLink.origin}${bookLink.pathname}?notes=${encodeURIComponent(notes)}`;
      // Never block the booking on the store; keepalive lets it land in flight.
      postIntake({ status: 'booking', level, region, looking, website }).catch(() => {});
      window.location.assign(url);
      return;
    }

    const button = target.closest<HTMLButtonElement>('.waitlist-row button');
    if (!button) return;

    const row = button.closest('.waitlist-row') as HTMLElement;
    const input = row.querySelector('input[type="email"]') as HTMLInputElement;
    const email = input.value.trim();
    if (!EMAIL_RE.test(email)) {
      input.focus();
      showWaitlistError(row, 'That email looks off — mind checking it?');
      return;
    }

    button.disabled = true;
    const { level, region, looking, website } = readIntake();
    try {
      const response = await postIntake({ status: 'waitlist', email, level, region, looking, website });
      if (!response.ok) throw new Error(String(response.status));
      const ok = document.createElement('p');
      ok.className = 'waitlist-ok';
      ok.textContent = "You're on the list. If this opens up, yours will be among the first doors I knock on.";
      row.replaceWith(ok);
      verdict.querySelector('.waitlist-error')?.remove();
    } catch {
      button.disabled = false;
      showWaitlistError(row, "That didn't go through — try again?");
    }
  });
</script>
