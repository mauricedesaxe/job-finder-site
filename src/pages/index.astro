---
import PageLayout from '../layouts/PageLayout.astro';

const title = 'Job Fiend';
const description =
  "I'll run an automated private job search customized just for you.";

const steps = [
  {
    title: 'How it works',
    sections: [
      {
        heading: 'Daily search',
        body: "My system will search for jobs for you every day based on criteria you provided and then put them in a review queue.",
      },
      {
        heading: 'It learns you',
        body: "As you pursue or reject provided jobs, the system learns what you want and gives you more of that.",
      },
    ],
  },
  {
    title: 'Free and open',
    sections: [
      {
        heading: 'Open source',
        body: "Everything is open source and the system itself, not including its various underlying vendors and providers, is free to use.",
      },
      {
        heading: 'Managed plans',
        body: "This means that you can set it up yourself but to abstract that work from you, I offer a limited number of free managed plans.",
      },
    ],
  },
  {
    title: 'The setup call',
    sections: [
      {
        heading: 'Getting to know you',
        body: "We book a call and I spend time with you learning about you. I want to know about your experiences. I want to know about your needs, wants, and desires.",
      },
      {
        heading: 'First jobs, live',
        body: "We point the system at your profile while on the call and we look at the first few jobs it finds together.",
      },
    ],
  },
  {
    title: 'Daily reviews',
    sections: [
      {
        heading: 'New jobs every day',
        body: "Once we're done with our call, the system should have some degree of understanding about what jobs you want and it should give you more jobs every day.",
      },
      {
        heading: 'Your feedback steers it',
        body: "I want you to review them. I want you to give feedback when a job is bad and when a job is good and why.",
      },
    ],
  },
  {
    title: 'The value exchange',
    sections: [
      {
        heading: 'The deal',
        body: "This is the core value exchange I'm asking for from you.",
      },
      {
        heading: 'It finds you jobs',
        body: "My system will absolutely find you jobs once it's past that initial learning phase. I know because it found me jobs that I liked and applied to.",
      },
      {
        heading: 'What I need from you',
        body: "But I need to be able to collect this feedback from you to be able to improve the system even further so that more people can benefit from it.",
      },
    ],
  },
  {
    title: "Why it's free",
    sections: [
      {
        heading: 'No one pays',
        body: "As everything stands right now I'm not making any money from this. I'm not charging you. I'm not charging the employer.",
      },
      {
        heading: 'I pay the bills',
        body: "In fact I'm spending out of pocket on all the vendors and providers underneath the system that will run for you.",
      },
      {
        heading: 'The long game',
        body: "I do this, of course, not out of the kindness of my soul. I am hoping that as I show this to more people and I gather more feedback, I will eventually be able to turn it into some sort of a commercial project.",
      },
    ],
  },
];

const circlePath =
  'M20 3.2 C 30.5 2.2, 37.6 8.8, 37.2 19.6 C 36.8 30.6, 30.2 36.9, 19.8 36.8 C 9.4 36.7, 2.9 30.4, 3.1 19.8 C 3.3 9.6, 9.8 4.2, 20 3.2';
---

<PageLayout title={title} description={description} canonicalPath="/">
  <main class="page">
    <header class="hero">
      <img
        class="walker"
        src="/images/job-fiend-walking.png"
        alt="The Job Fiend character walking, looking back over her shoulder."
        width="500"
        height="500"
      />
      <div class="hero-copy">
        <h1>{title}</h1>
        <svg class="scribble" viewBox="0 0 220 18" aria-hidden="true">
          <path
            d="M2 11 C 28 4, 46 16, 72 9 S 120 17, 148 8 S 196 15, 218 10"
            fill="none"
            stroke="#49B6E5"
            stroke-width="3"
            stroke-linecap="round"
          />
        </svg>
        <p class="lede">{description}</p>
      </div>
    </header>

    <div class="actions">
      <svg class="arrow" viewBox="0 0 110 64" aria-hidden="true">
        <path
          d="M100 8 C 68 2, 34 14, 18 44"
          fill="none"
          stroke="#49B6E5"
          stroke-width="3"
          stroke-linecap="round"
        />
        <path
          d="M28 36 L 16 47 L 31 51"
          fill="none"
          stroke="#49B6E5"
          stroke-width="3"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
      <a class="book" href="https://cal.com/alexlazar/30-min-meeting">Book a setup</a>
      <a
        class="repo"
        href="https://github.com/mauricedesaxe/job-finder"
        rel="noopener noreferrer">Github Repo</a
      >
    </div>

    {steps.map((step, i) => (
      <section class="block">
        <span class="marker" aria-hidden="true">
          <svg viewBox="0 0 40 40">
            <path
              d={circlePath}
              fill="none"
              stroke="#263D5B"
              stroke-width="2"
              stroke-linecap="round"
              filter="url(#wobble)"
            />
          </svg>
          <span class="marker-n">{i + 1}</span>
        </span>
        <div class="block-body">
          <h2>{step.title}</h2>
          {step.sections.map((section) => (
            <div class="sub">
              <h3>{section.heading}</h3>
              <p>{section.body}</p>
            </div>
          ))}
        </div>
      </section>
    ))}

    <section class="demo">
      <div class="demo-frame">
        <iframe
          src="https://www.youtube.com/embed/bO7vzA0xbWg"
          title="Job Fiend demo"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          allowfullscreen
          loading="lazy"></iframe>
      </div>
    </section>

    <section class="outro">
      <svg class="scribble outro-scribble" viewBox="0 0 220 18" aria-hidden="true">
        <path
          d="M2 11 C 28 4, 46 16, 72 9 S 120 17, 148 8 S 196 15, 218 10"
          fill="none"
          stroke="#49B6E5"
          stroke-width="3"
          stroke-linecap="round"
        />
      </svg>
      <div class="actions outro-actions">
        <a class="book book-big" href="https://cal.com/alexlazar/30-min-meeting"
          >Book a setup</a
        >
        <a
          class="repo"
          href="https://github.com/mauricedesaxe/job-finder"
          rel="noopener noreferrer">Github Repo</a
        >
      </div>
    </section>
  </main>
</PageLayout>
