---
import PageLayout from '../layouts/PageLayout.astro';

const title = 'Book your setup — Job Fiend';
const description =
  'A short intake so the setup call spends its time on you, not on paperwork.';
---

<PageLayout title={title} description={description} canonicalPath="/intake">
  <main class="page intake">
    <header class="intake-hero">
      <h1>Book your setup call</h1>
      <svg class="scribble" viewBox="0 0 220 18" aria-hidden="true">
        <path
          d="M2 11 C 28 4, 46 16, 72 9 S 120 17, 148 8 S 196 15, 218 10"
          fill="none"
          stroke="#49B6E5"
          stroke-width="3"
          stroke-linecap="round"></path>
      </svg>
      <p class="lede">
        I don't want to waste your time nor mine. For the white glove offering
        to work well for you and be worth it to me, it would be best if you had
        at least a couple of years of experience and if you are based in Europe
        or North America. If that's not you, either use the open-source version
        of the system or sign up for the waitlist.
      </p>
    </header>

    <form class="intake-form" id="intake">
      <fieldset>
        <legend>1 · Where are you in your career?</legend>
        <label><input type="radio" name="level" value="junior" /> Junior</label>
        <label><input type="radio" name="level" value="mid" checked /> Mid-level</label>
        <label>
          <input type="radio" name="level" value="senior" /> Senior or above
        </label>
      </fieldset>

      <fieldset>
        <legend>2 · Where are you based?</legend>
        <label><input type="radio" name="region" value="eu" checked /> Europe</label>
        <label>
          <input type="radio" name="region" value="na" /> North America
        </label>
        <label>
          <input type="radio" name="region" value="other" /> Somewhere else
        </label>
      </fieldset>

      <label class="wide">
        <span class="q">3 · What are you looking for?</span>
        <textarea
          name="looking"
          rows="5"
          placeholder="The types of role, stack, compensation, time zone, or other constraints that you're looking for would be useful to know."></textarea>
      </label>
    </form>

    <div class="verdict" id="verdict" aria-live="polite">
      <!-- filled by the script -->
    </div>

    <template id="fit">
      <h2>You're who this is for.</h2>
      <p>
        Book a time. We point the system at your profile on the call and look
        at the first jobs it finds together.
      </p>
      <a class="book book-big" href="https://cal.com/alexlazar/30-min-meeting"
        >Book a setup</a
      >
    </template>

    <template id="waitlist-junior">
      <h2>Not yet.</h2>
      <p>
        I'm not offering the white-glove experience to junior developers just
        yet. Feel free to use the open-source version of the system yourself
        and put your email in to get updates.
      </p>
      <div class="waitlist-row">
        <input type="email" placeholder="you@example.com" aria-label="Email" />
        <button class="book" type="button">Join the waitlist</button>
      </div>
      <p class="waitlist-note">Product updates if I get traction and decide to take this project further.</p>
    </template>

    <template id="waitlist-region">
      <h2>Not here yet.</h2>
      <p>
        I'm not offering the White Club experience to people outside of Europe
        or North America just yet. Feel free to use the open-source version of
        the system yourself and put your email in to get updates.
      </p>
      <div class="waitlist-row">
        <input type="email" placeholder="you@example.com" aria-label="Email" />
        <button class="book" type="button">Join the waitlist</button>
      </div>
      <p class="waitlist-note">Product updates if I get traction and decide to take this project further.</p>
    </template>
  </main>
</PageLayout>

<script>
  const form = document.getElementById('intake') as HTMLFormElement;
  const verdict = document.getElementById('verdict') as HTMLElement;

  function route() {
    const data = new FormData(form);
    const level = (data.get('level') as string) ?? 'mid';
    const region = (data.get('region') as string) ?? 'eu';
    const id = level === 'junior' ? 'waitlist-junior' : region === 'other' ? 'waitlist-region' : 'fit';
    const tpl = document.getElementById(id) as HTMLTemplateElement;
    verdict.replaceChildren(tpl.content.cloneNode(true));
  }

  form.addEventListener('change', route);
  route();
</script>

<style>
  .intake {
    max-width: 36rem;
  }

  .intake-hero h1 {
    margin: 0 0 var(--space-3);
    font-size: clamp(2.2rem, 7vw, 3.2rem);
    font-weight: 400;
    line-height: 1.1;
  }

  .scribble {
    display: block;
    width: min(12rem, 60%);
    margin: 0 0 var(--space-4);
  }

  .lede {
    margin: 0;
    font-size: 1.3rem;
  }

  .intake-form {
    margin-top: var(--space-8);
    display: grid;
    gap: var(--space-6);
  }

  fieldset {
    border: 0;
    padding: 0;
    margin: 0;
  }

  legend,
  .q {
    display: block;
    font-size: 1.15rem;
    color: var(--secondary);
    margin-bottom: var(--space-3);
  }

  label {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.45rem 0;
    cursor: pointer;
  }

  input[type='radio'] {
    accent-color: var(--secondary);
    width: 1.1rem;
    height: 1.1rem;
  }

  .wide {
    display: block;
  }

  textarea {
    width: 100%;
    font: inherit;
    color: inherit;
    padding: 0.7rem 0.9rem;
    border: 2px solid #a8d6ef;
    border-radius: 18px 4px 16px 4px / 4px 16px 4px 18px;
    background: #fdfeff;
  }

  .verdict {
    margin-top: var(--space-8);
    padding: var(--space-6);
    border: 2px solid #a8d6ef;
    border-radius: var(--sketch-radius);
    background: #fdfeff;
  }

  .verdict h2 {
    margin: 0 0 var(--space-2);
    font-size: 1.5rem;
    font-weight: 400;
    color: var(--secondary);
  }

  .verdict p {
    margin: 0 0 var(--space-5);
  }

  .waitlist-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    align-items: stretch;
  }

  .waitlist-row input[type='email'] {
    flex: 1 1 14rem;
    font: inherit;
    padding: 0.55rem 0.9rem;
    border: 2px solid #a8d6ef;
    border-radius: 14px 4px 14px 4px / 4px 14px 4px 14px;
    background: #fff;
  }

  .waitlist-note {
    margin: var(--space-3) 0 0;
    font-size: 0.9rem;
    color: var(--secondary);
  }
</style>
